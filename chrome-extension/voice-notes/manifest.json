{
  "manifest_version": 3,
  "name": "Voice Notes - Floating Panel",
  "version": "3.0",
  "description": "A side panel that stays open across every tab. Click the mic and keep talking — it notes down the whole thing as one continuous note until you turn it off.",
  "permissions": ["storage", "sidePanel"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Voice Notes"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
